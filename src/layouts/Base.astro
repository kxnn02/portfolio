---
import { Font } from 'astro:assets';
import '../styles/global.css';

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Kenneth Clein T. Fernandez — I build software that ships." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f8f5ef" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script is:inline>
			document.documentElement.classList.add('js');
			// If the reveal script never runs, show everything. See index.astro.
			window.setTimeout(function () {
				if (!window.__revealReady) document.documentElement.classList.remove('js');
			}, 3000);
		</script>

		<Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '600' }]} />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" />
	</head>
	<body>
		<slot />
	</body>
</html>
