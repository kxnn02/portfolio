---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Kenneth Clein T. Fernandez',
	url: canonical.href,
	image: ogImage.href,
	jobTitle: 'BSIT student',
	description,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Manila',
		addressCountry: 'PH',
	},
	affiliation: {
		'@type': 'CollegeOrUniversity',
		name: 'San Sebastian College – Recoletos Manila',
	},
	knowsAbout: ['JavaScript', 'Python', 'Java', 'React Native', 'SQL', 'PostgreSQL', 'Supabase'],
	sameAs: ['https://github.com/kxnn02', 'https://www.linkedin.com/in/kenneth-clein-fernandez-8a6b48258'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Kenneth Clein T. Fernandez" />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Kenneth Clein T. Fernandez" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Kenneth Clein T. Fernandez · I find the problem. I ship the fix." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Kenneth Clein T. Fernandez · I find the problem. I ship the fix." />
		<meta name="theme-color" content="#ffffff" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

		<script is:inline>
			document.documentElement.classList.add('js');
			// If the reveal script never runs, show everything. See index.astro.
			window.setTimeout(function () {
				if (!window.__revealReady) document.documentElement.classList.remove('js');
			}, 3000);
		</script>

		<Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '600' }]} />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" preload />
	</head>
	<body>
		<slot />
	</body>
</html>
