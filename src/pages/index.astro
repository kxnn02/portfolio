---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ccShot from '../assets/shots/campuscurrents.png';
import taskbotShot from '../assets/shots/taskbot-help.png';
import kidshubShot from '../assets/shots/kidshub-login.png';
import devconShot from '../assets/shots/devconplus-home.png';
import portrait from '../assets/shots/portrait.jpg';

const title = 'Kenneth Clein T. Fernandez · I find the problem. I ship the fix';
const description =
	'Third-year BSIT student in Manila. I’ve shipped an Android alert app, a Telegram bot in daily use, and a chatbot for DEVCON Kids. Open to internships & projects';
const EMAIL = 'fernandezk728@gmail.com';

/* Each project carries one wide screenshot, mounted in the same frame so the
   four rows read as a set rather than four different crops. */
const work = [
	{
		idx: '01',
		slug: 'campuscurrents',
		short: 'CampusCurrents',
		kind: 'Android beta · 2026',
		name: 'CampusCurrents',
		href: 'https://campus-currents-website.vercel.app',
		role: 'Project manager & lead developer',
		tools: ['React Native', 'Next.js', 'Supabase', 'PostgreSQL'],
		docket: { problem: 'Suspension calls scattered across Facebook', fix: 'One push feed' },
		problem:
			'Campus announcements were scattered across Facebook and other platforms, so suspension calls and emergency notices were easy to miss on the phones students already check.',
		body: 'We built one Android app for class suspensions, emergency notices and campus announcements. Each alert arrives as a push notification on the student’s phone, in one feed, instead of another page to check.',
		stack: 'React Native (Expo) · Next.js · Supabase · PostgreSQL',
		links: [
			{ label: 'Project site', href: 'https://campus-currents-website.vercel.app' },
			{ label: 'Download APK · 102 MB', href: 'https://github.com/kxnn02/campus-currents/releases/latest' },
			{ label: 'Source code', href: 'https://github.com/kxnn02/campus-currents' },
		],
		redline: {
			tone: 'accent',
			marks: [
				{
					key: '1a',
					shape: 'ellipse',
					cx: 1108,
					cy: 330,
					rx: 86,
					ry: 86,
					rotate: -4,
					leader: [1194, 330, 1258],
					tag: { x: 87.6, y: 36.7 },
				},
				{
					key: '1b',
					shape: 'rect',
					x: 1026,
					y: 514,
					w: 216,
					h: 66,
					rx: 10,
					rotate: -1,
					leader: [1242, 547, 1258],
					tag: { x: 87.6, y: 60.8 },
				},
			],
			notes: [
				{
					key: '1a',
					title: 'One status.',
					text: 'The phone answers whether classes are on before a student checks Facebook.',
				},
				{
					key: '1b',
					title: 'The notice.',
					text: 'A suspension lands in the same feed, with the date and time attached.',
				},
			],
		},
		visual: {
			src: ccShot,
			widths: [640, 960, 1440],
			alt: 'The CampusCurrents landing page: the headline “Stay Informed. Stay Safe.”, a red Try the Beta button, and a phone showing its Status screen reading CLASSES ARE ON.',
			caption: 'Landing page',
			note: 'campus-currents-website.vercel.app',
			noteHref: 'https://campus-currents-website.vercel.app',
		},
	},
	{
		idx: '02',
		slug: 'task-bot',
		short: 'Task Bot',
		kind: 'Telegram bot · 2026',
		name: 'DEVCON Cohort 5 Task Bot',
		href: 'https://telegram-taskbot-ten.vercel.app',
		role: 'Solo build',
		tools: ['Telegram Bot API', 'Next.js', 'Supabase'],
		docket: { problem: 'Tasks kept in personal trackers', fix: 'A bot inside Telegram' },
		problem:
			'When a higher-up assigned a task, the cohort had no shared tracker, so everyone made their own. Coordination lived in a Telegram group.',
		body: 'I built the bot inside Telegram, where the cohort already worked: a morning standup card grouped by person, overdue reminders and weekly digests, with board, team and activity views in a Next.js dashboard behind it.',
		stack: 'Telegram Bot API · Next.js · Supabase',
		links: [
			{ label: 'Dashboard · Telegram login', href: 'https://telegram-taskbot-ten.vercel.app' },
			{ label: 'Source code', href: 'https://github.com/kxnn02/telegram-taskbot' },
		],
		redline: {
			tone: 'paper',
			marks: [
				{
					key: '2a',
					shape: 'rect',
					x: 157,
					y: 194,
					w: 262,
					h: 20,
					rx: 3,
					rotate: 0,
					leader: [423, 204, 638],
					tag: { x: 71.9, y: 28.2 },
				},
				{
					key: '2b',
					shape: 'rect',
					x: 157,
					y: 239,
					w: 445,
					h: 20,
					rx: 3,
					rotate: 0,
					leader: [606, 249, 638],
					tag: { x: 71.9, y: 34.4 },
				},
			],
			notes: [
				{
					key: '2a',
					title: 'The standup.',
					text: 'One report, grouped by person, in the group the cohort already uses.',
				},
				{
					key: '2b',
					title: 'Task creation.',
					text: 'A task lands in the same thread, not a personal tracker.',
				},
			],
		},
		visual: {
			src: taskbotShot,
			widths: [480, 720, 889],
			alt: 'A Telegram group with the bot\u2019s Available Commands card: /tasks, /deadlines and /standup to read work, /addtask to create it, and /done, /complete, /update and /due to change it.',
			caption: 'Command card, in Telegram',
			note: 'In the cohort’s Telegram group',
		},
	},
	{
		idx: '03',
		slug: 'kids-hub',
		short: 'Kids Hub',
		kind: 'Nonprofit platform · 2026',
		name: 'DEVCON Kids Hub',
		href: 'https://devcon-kids-hub-2-0.vercel.app',
		role: 'I built the AI chatbot',
		tools: ['React', 'Vite', 'Supabase', 'pgvector', 'Mistral'],
		docket: { problem: 'Volunteers waiting on a higher-up', fix: 'Answers from the docs' },
		problem:
			'DEVCON Kids had no centralized platform. Borrowed materials had no shared record; some went missing and no one could say who had them. Onboarding a volunteer meant asking a higher-up and waiting for an answer.',
		body: 'The platform covers events, volunteer onboarding, chapters, inventory and reporting. The chatbot answers onboarding questions from DEVCON Kids’ documents.',
		stack: 'React · Vite · Supabase · pgvector · Mistral',
		links: [
			{ label: 'Live site', href: 'https://devcon-kids-hub-2-0.vercel.app' },
			{ label: 'Team repo', href: 'https://github.com/Debb1ie/DEVCON-Kids-Hub-2.0' },
		],
		redline: {
			tone: 'paper',
			marks: [
				{
					key: '3a',
					shape: 'rect',
					x: 1232,
					y: 773,
					w: 390,
					h: 30,
					rx: 4,
					rotate: 0,
					leader: [1628, 788, 1658],
					tag: { x: 88.3, y: 91.1 },
				},
			],
			notes: [
				{
					key: '3a',
					title: 'Role-based access.',
					text: 'Approval comes from the chapter lead. The request starts at sign-in.',
				},
			],
		},
		visual: {
			src: kidshubShot,
			widths: [640, 960, 1440],
			alt: 'The DEVCON Kids Hub sign-in page: a constellation graphic and the words “Learn. Build. Belong.” on the left, and a sign-in card on the right offering Continue with Google or email.',
			caption: 'Sign-in, role-based',
			note: 'The AI chat sits behind it',
		},
	},
	{
		idx: '04',
		slug: 'devcon-plus',
		short: 'DEVCON+',
		kind: 'Internship · Aug–Sep 2026',
		name: 'DEVCON+',
		href: 'https://devcon.plus',
		role: 'Voluntary intern',
		tools: ['React', 'TypeScript', 'NestJS', 'Supabase', 'Firebase Auth'],
		docket: { problem: 'Duplicate chapter rows', fix: 'One row per chapter' },
		problem:
			'Duplicate chapter entries were showing up in DEVCON’s admin dashboard, and chapter activity had no visible ranking.',
		body: 'During my internship on the membership platform (event registration, points and rewards, chapter operations across 13 chapters), I fixed the duplicate chapter entries and proposed the chapter leaderboard.',
		stack: 'React · TypeScript · NestJS · Supabase · Firebase Auth',
		links: [{ label: 'Public site', href: 'https://devcon.plus' }],
		caseNotes: [
			{ label: 'Found', text: 'Duplicate chapter entries in the admin dashboard.' },
			{ label: 'Changed', text: 'Fixed the duplicates, AI-assisted.' },
			{ label: 'Not shipped', text: 'The chapter leaderboard. Proposed only.' },
		],
		visual: {
			src: devconShot,
			widths: [640, 960, 1440],
			alt: 'The DEVCON+ member home screen: a greeting, 100 XP earned, quick actions for Find Jobs, Volunteer and Earn Points, and an Events Near You section.',
			caption: 'Member home',
			note: 'The admin dashboard is private',
		},
	},
];

/* The strip is a tool index, not decoration: each technology carries the
   projects whose stacks name it. Built from the same `tools` arrays, so the
   strip cannot drift from the rows. */
const toolIndex = new Map<string, { idx: string; short: string; slug: string }[]>();

for (const project of work) {
	for (const tool of project.tools) {
		const projects = toolIndex.get(tool) ?? [];
		projects.push({ idx: project.idx, short: project.short, slug: project.slug });
		toolIndex.set(tool, projects);
	}
}

const tools = [...toolIndex].map(([name, projects]) => ({ name, projects }));
---

<Base {title} {description}>
	<a class="skip" href="#work">Skip to work</a>

	<header class="site-head">
		<div class="shell site-head__in">
			<a class="brand" href="#top">
				<span class="sr-only">Kenneth Clein T. Fernandez, back to top</span>
				<span class="brand__name" aria-hidden="true">Kenneth Fernandez</span>
				<span class="brand__mark" aria-hidden="true">KCF</span>
			</a>
			<nav class="nav" aria-label="Sections">
				<a href="#work">Work</a>
				<a href="#about">About</a>
				<a class="nav__background" href="#background">Background</a>
				<a href="#contact">Contact</a>
			</nav>
		</div>
	</header>

	<main id="main">
		<section class="hero" id="top">
			<div class="shell">
				<div class="hero__masthead">
					<p class="label">Kenneth Clein T. Fernandez</p>
					<p class="label hero__dateline">Manila · <span data-clock>GMT+8</span></p>
				</div>
				<div class="hero__type">
					<h1 class="hero__title">
						<span class="line"><span>I find the problem.</span></span>
						<span class="line"
							><span
								><a class="fix-link" href="#work"
									>I ship the <em>fix.</em><span class="fix-link__arrow" aria-hidden="true">↗</span
									><span class="sr-only"> See the work</span></a
								></span
							></span
						>
					</h1>
				</div>

				<div class="hero__foot">
					<p class="hero__lede">
						Third-year BSIT student in Manila. I've shipped an Android campus-alert app, a Telegram
						bot in daily use, and a chatbot for DEVCON Kids.
					</p>

					<div class="hero__side">
						<p class="status">Open to internships &amp; projects</p>
						<div class="hero__actions">
							<a class="btn" href="#work">
								See the work
								<svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
									<path
										d="M2.5 7h9M7.5 3l4 4-4 4"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</a>
							<a class="btn btn--ghost" href={`mailto:${EMAIL}`}>Email me</a>
						</div>
						<p class="hero__links">
							<a href="https://github.com/kxnn02" target="_blank" rel="me noopener"
								>GitHub<span class="sr-only"> (opens in a new tab)</span></a
							>
							<a href="https://www.linkedin.com/in/kenneth-clein-fernandez-8a6b48258" target="_blank" rel="me noopener"
								>LinkedIn<span class="sr-only"> (opens in a new tab)</span></a
							>
							<a href={`mailto:${EMAIL}?subject=R%C3%A9sum%C3%A9%20request`}>Résumé on request</a>
						</p>
					</div>
				</div>

				<nav class="hero__index" aria-label="Projects">
					<span class="label">Contents</span>
					<ol class="docket">
						{work.map((project) => (
							<li class="docket__row">
								<span class="docket__no">{project.idx}</span>
								<p class="docket__problem">{project.docket.problem}</p>
								<div class="docket__fixline">
									<svg
										class="docket__arrow"
										width="12"
										height="12"
										viewBox="0 0 14 14"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="M2.5 7h9M7.5 3l4 4-4 4"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
									<p class="docket__fix">{project.docket.fix}</p>
									<a class="docket__project" href={`#${project.slug}`}>
										{project.short}<span class="sr-only">, jump to project</span>
									</a>
								</div>
							</li>
						))}
					</ol>
				</nav>
			</div>
			<div class="hero__bloom" data-bloom aria-hidden="true"></div>
		</section>

		<section class="section" id="work" aria-labelledby="work-title">
			<div class="shell">
				<header class="section__head" data-reveal>
					<p class="section__folio">01 / Work</p>
					<h2 id="work-title">Selected work</h2>
				</header>

				{
					work.map((project) => (
						<article class="project" id={project.slug}>
							<div class="project__text" data-reveal>
								<p class="project__meta">
									<span>{project.idx}</span>
									<span>{project.kind}</span>
								</p>
								<h3 class="project__title">
									<a href={project.href} target="_blank" rel="noopener"
										>{project.name}<span class="sr-only"> (opens in a new tab)</span></a
									>
								</h3>
								<p class="project__problem">{project.problem}</p>
								<p class="project__body">{project.body}</p>
								<p class="project__stack">{project.stack}</p>
								<p class="project__role">
									<span class="project__role-label">My part</span>{' '}
									<span class="project__role-value">{project.role}</span>
								</p>
								<ul class="project__links">
									{project.links.map((link) => (
										<li>
											<a href={link.href} target="_blank" rel="noopener"
												>{link.label}<span class="sr-only"> (opens in a new tab)</span></a
											>
										</li>
									))}
								</ul>
							</div>

							<figure class="project__visual" data-wipe>
								<div class="shot-wrap">
									<a href={project.visual.noteHref ?? project.href} target="_blank" rel="noopener">
										<Image
											src={project.visual.src}
											alt={project.visual.alt}
											widths={project.visual.widths}
											sizes="(max-width: 56rem) 92vw, 55vw"
											format="webp"
											quality={82}
											loading="eager"
										/>
										{project.redline && (
											<>
												<svg
													class:list={['redline', project.redline.tone === 'paper' && 'redline--paper']}
													viewBox={`0 0 ${project.visual.src.width} ${project.visual.src.height}`}
													preserveAspectRatio="none"
													aria-hidden="true"
													focusable="false"
												>
													{project.redline.marks.map((mark) =>
														'cx' in mark ? (
															<ellipse
																cx={mark.cx}
																cy={mark.cy}
																rx={mark.rx}
																ry={mark.ry}
																transform={`rotate(${mark.rotate} ${mark.cx} ${mark.cy})`}
																vector-effect="non-scaling-stroke"></ellipse>
														) : (
															<rect
																x={mark.x}
																y={mark.y}
																width={mark.w}
																height={mark.h}
																rx={mark.rx}
																transform={`rotate(${mark.rotate} ${mark.x + mark.w / 2} ${mark.y + mark.h / 2})`}
																vector-effect="non-scaling-stroke"></rect>
														)
													)}
													{project.redline.marks.map((mark) => (
														<path
															d={`M${mark.leader[0]} ${mark.leader[1]}H${mark.leader[2]}`}
															vector-effect="non-scaling-stroke"></path>
													))}
												</svg>
												{project.redline.marks.map((mark) => (
													<span
														class:list={[
															'redline-tag',
															project.redline.tone === 'paper' && 'redline-tag--paper',
														]}
														style={`left:${mark.tag.x}%;top:${mark.tag.y}%`}
														aria-hidden="true">{mark.key}</span>
												))}
											</>
										)}
										<span class="loupe" data-loupe aria-hidden="true"></span>
										<span class="sr-only"> (opens in a new tab)</span>
									</a>
								</div>
								<figcaption class="project__caption">
									<span><span class="fig">Fig. {project.idx}</span> {project.visual.caption}</span>
									{project.visual.noteHref ? (
										<a href={project.visual.noteHref} target="_blank" rel="noopener"
											>{project.visual.note}<span class="sr-only"> (opens in a new tab)</span></a
										>
									) : (
										<span>{project.visual.note}</span>
									)}
								</figcaption>
								{project.redline && (
									<ul class="redline-notes" aria-label={`Details marked on the ${project.short} plate`}>
										{project.redline.notes.map((note) => (
											<li>
												<span class="redline-key">{note.key}</span>
												<p>
													<b>{note.title}</b> {note.text}
												</p>
											</li>
										))}
									</ul>
								)}
								{project.caseNotes && (
									<aside class="case-notes" aria-label={`${project.short} case notes`}>
										<p class="case-notes__label">Case notes</p>
										<dl>
											{project.caseNotes.map((note) => (
												<div>
													<dt>{note.label}</dt>
													<dd>{note.text}</dd>
												</div>
											))}
										</dl>
									</aside>
								)}
							</figure>
						</article>
					))
				}
			</div>
		</section>

		{/* The four projects' own stacks, gathered into one line. aria-hidden
		    because it repeats what each row already states, and because the
		    second half is a duplicate that exists only to make the loop join.
		    The pause button sits outside the strip: a loop that starts on its
		    own needs a user stop (WCAG 2.2.2), and hover is not one on touch. */}
		{/* The first set is the accessible index; the second is the visual
		    duplicate that makes the loop join, hidden from assistive tech. Hover
		    works on either set, keyboard focus lands in the first. */}
		<div class="strip-band">
			<button class="strip-toggle" type="button" data-strip-toggle aria-controls="tool-strip">
				<span data-strip-label>Pause</span><span class="sr-only"> the scrolling technology list</span>
			</button>
			<div class="strip" id="tool-strip" data-strip role="group" aria-label="Tools by project">
				<div class="strip__in">
					{[0, 1].map((set) => (
						<span class="strip__set" aria-hidden={set === 1 ? 'true' : undefined}>
							{tools.map((tool) => (
								<>
									{set === 0 ? (
										<button
											class="strip__tool"
											type="button"
											data-tool={tool.name}
											data-projects={tool.projects.map((project) => project.slug).join(' ')}
											data-readout={`${tool.name} · ${tool.projects.map((project) => `${project.idx} ${project.short}`).join(', ')}`}
											aria-label={`${tool.name}, used in ${tool.projects.map((project) => project.short).join(', ')}`}
										>
											{tool.name}
										</button>
									) : (
										<span
											data-tool={tool.name}
											data-projects={tool.projects.map((project) => project.slug).join(' ')}
											data-readout={`${tool.name} · ${tool.projects.map((project) => `${project.idx} ${project.short}`).join(', ')}`}
										>
											{tool.name}
										</span>
									)}
									<i aria-hidden="true">·</i>
								</>
							))}
						</span>
					))}
				</div>
			</div>
			<div class="strip__foot">
				<span class="strip__legend">Tools, by project</span>
				<p class="strip__readout" data-strip-readout aria-hidden="true">Pick a tool to find its project</p>
			</div>
		</div>

		<section class="section" id="about" aria-labelledby="about-title">
			<div class="shell">
				<header class="section__head" data-reveal>
					<p class="section__folio">02 / About</p>
					<h2 id="about-title">About</h2>
				</header>

				<div class="about" data-reveal>
					<figure class="about__photo">
						<Image
							src={portrait}
							alt="Kenneth Fernandez, in a white shirt, dark tie and glasses, giving two thumbs up."
							widths={[320, 480, 640]}
							sizes="(max-width: 56rem) 60vw, 22rem"
							format="webp"
							quality={82}
							loading="eager"
						/>
						<figcaption>Kenneth Fernandez</figcaption>
					</figure>

					<div class="about__text">
						<p class="about__lede">
							I'm Kenneth. I got into software by playing games and looking for ways to beat them.
							Eventually that turned into problem solving: <em>learn how the system works, find the
							gap, build the fix.</em>
						</p>
						<p>
							I'm a third-year BSIT student at San Sebastian College – Recoletos Manila. Every project
							here started with a problem: announcements scattered across Facebook, tasks kept in
							personal trackers, materials nobody could trace, duplicate chapter rows. Most of what I
							know came from building the fix, with a small team or on my own. I work in JavaScript
							and Python, with Java from coursework.
						</p>
						<p>
							Manila is a tough place to be a student. The commute is hard, so I've learned to focus
							on what I can control: the next feature, the next bug, the next thing I can ship. Outside
							code, I play Valorant and League of Legends, play guitar, drink coffee and go to tech
							events when I can.
						</p>
						<p>
							I still like the part after the demo: auth, migrations, the bug a tester finds on a
							Friday. I'm mainly looking for an OJT or internship where I own a feature end to end.
							I'm also open to freelance work: real projects for small businesses with a real problem
							and real users.
						</p>
						<p class="about__creed">
