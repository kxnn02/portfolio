							<a href={`mailto:${EMAIL}?subject=R%C3%A9sum%C3%A9%20request`}>Résumé on request</a>
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="work" aria-labelledby="work-title">
			<div class="shell">
				<header class="section__head" data-reveal>
					<span class="section__num">01</span>
					<h2 id="work-title">Selected work</h2>
					<p class="section__note">All four are running</p>
				</header>

				{
					work.map((project) => (
						<article class="project">
							<div class="project__text" data-reveal>
								<p class="project__meta">
									<span>{project.idx}</span>
									<span>{project.kind}</span>
								</p>
								<h3 class="project__title">
									<a href={project.href} target="_blank" rel="noopener">{project.name}</a>
								</h3>
								<p class="project__problem">{project.problem}</p>
								<p class="project__body">{project.body}</p>
								<p class="project__stack">{project.stack}</p>
								<p class="project__role">
									<span>My part</span> {project.role}
								</p>
								<ul class="project__links">
									{project.links.map((link) => (
										<li>
											<a href={link.href} target="_blank" rel="noopener">{link.label}</a>
										</li>
									))}
								</ul>
							</div>

							<figure class="project__visual" data-wipe>
								{project.visual.kind === 'shot' && (
									<>
										<div class="shot-wrap">
											<Image
												src={project.visual.src}
												alt={project.visual.alt}
												widths={[640, 960, 1440]}
												sizes="(max-width: 56rem) 92vw, 55vw"
												format="webp"
												quality={82}
												loading="eager"
											/>
										</div>
										<figcaption class="project__caption">
											<span>{project.visual.caption}</span>
											{project.visual.noteHref ? (
												<a href={project.visual.noteHref} target="_blank" rel="noopener">{project.visual.note}</a>
											) : (
												<span>{project.visual.note}</span>
											)}
										</figcaption>
									</>
								)}

								{project.visual.kind === 'card' && (
									<>
										<div class="panel">
											<Image
												class="panel__shot"
												src={project.visual.src}
												alt={project.visual.alt}
												widths={[400, 620, 900]}
												sizes="(max-width: 56rem) 76vw, 26rem"
												format="webp"
												quality={82}
												loading="eager"
											/>
										</div>
										<figcaption class="project__caption">
											<span>{project.visual.caption}</span>
											<span>{project.visual.note}</span>
										</figcaption>
									</>
								)}
							</figure>
						</article>
					))
				}
			</div>
		</section>

		{/* The four projects' own stacks, gathered into one line. aria-hidden
		    because it repeats what each row already states, and because the
		    second half is a duplicate that exists only to make the loop join. */}
		<div class="strip" aria-hidden="true">
			<div class="strip__in">
				<span class="strip__set">
					<span>React Native</span><i>·</i><span>Next.js</span><i>·</i><span>Supabase</span><i>·</i><span>PostgreSQL</span><i>·</i><span>Telegram Bot API</span><i>·</i><span>React</span><i>·</i><span>Vite</span><i>·</i><span>pgvector</span><i>·</i><span>Mistral</span><i>·</i><span>NestJS</span><i>·</i><span>TypeScript</span><i>·</i><span>Firebase Auth</span><i>·</i>
				</span>
				<span class="strip__set">
					<span>React Native</span><i>·</i><span>Next.js</span><i>·</i><span>Supabase</span><i>·</i><span>PostgreSQL</span><i>·</i><span>Telegram Bot API</span><i>·</i><span>React</span><i>·</i><span>Vite</span><i>·</i><span>pgvector</span><i>·</i><span>Mistral</span><i>·</i><span>NestJS</span><i>·</i><span>TypeScript</span><i>·</i><span>Firebase Auth</span><i>·</i>
				</span>
			</div>
		</div>

		<section class="section" id="about" aria-labelledby="about-title">
			<div class="shell">
				<header class="section__head" data-reveal>
					<span class="section__num">02</span>
					<h2 id="about-title">About</h2>
				</header>

				<div class="about" data-reveal>
					<figure class="about__photo">
						<Image
							src={portrait}
							alt="Kenneth Fernandez, in a white shirt, dark tie and orange-tinted glasses, giving two thumbs up."
							widths={[320, 480, 640]}
							sizes="(max-width: 56rem) 60vw, 22rem"
							format="webp"
							quality={82}
							loading="eager"
						/>
					</figure>

					<div class="about__text">
						<p class="about__lede">
							I'm Kenneth. I like the part of shipping that comes after the demo — <em>auth,
							migrations, the bug a tester finds on a Friday.</em>
						</p>
						<p>
							I'm a third-year BSIT student at San Sebastian College – Recoletos Manila. Every project
							here started with a problem — announcements scattered across Facebook, tasks kept in
							personal trackers, materials nobody could trace, duplicate chapter rows — and most of
							what I know came from building the fix, with a small team or on my own.
						</p>
						<p>
							I work in JavaScript and Python, with Java from coursework. I'm looking for an OJT or
							internship where I own a feature end to end instead of watching one get built.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="background" aria-labelledby="background-title">
			<div class="shell">
				<header class="section__head" data-reveal>
					<span class="section__num">03</span>
					<h2 id="background-title">Education &amp; leadership</h2>
				</header>

				<div class="bg-grid" data-reveal>
					<div class="bg-col">
						<h3>Education</h3>
						<p class="edu__degree">B.S. Information Technology</p>
						<p class="edu__school">San Sebastian College – Recoletos Manila</p>
						<p class="edu__award">Silver Medalist for Academic Excellence, 1st year, both semesters</p>
						<p class="edu__period">Expected 2028</p>
					</div>

					<div class="bg-col">
						<h3>Leadership</h3>
						<ul class="roles">
							<li class="roles__item">
								<div>
									<p class="roles__role">Founder and Lead</p>
									<p class="roles__org">AWS Learning Club, SSCR Manila</p>
								</div>
								<p class="roles__period">2026–2027</p>
							</li>
							<li class="roles__item">
								<div>
									<p class="roles__role">3rd Year Representative</p>
									<p class="roles__org">Junior Philippine Computer Society, SSCR Manila</p>
								</div>
								<p class="roles__period">2026–2027</p>
							</li>
							<li class="roles__item">
								<div>
									<p class="roles__role">2nd Year Representative</p>
									<p class="roles__org">Junior Philippine Computer Society, SSCR Manila</p>
								</div>
								<p class="roles__period">2025–2026</p>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="contact" id="contact" aria-labelledby="contact-title">
			<div class="shell">
				<p class="label" data-reveal>04 — Contact</p>
				<h2 class="contact__title" id="contact-title" data-reveal>
					Hiring for an internship? <em>I'd like to hear about it.</em>
				</h2>

				<div class="email-row" data-reveal>
					<a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
					<button
						class="copy"
						type="button"
						data-copy-email
						data-email={EMAIL}
						aria-label="Copy email address to clipboard"
					>
						Copy
					</button>
					<span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
				</div>

				<div class="contact__foot" data-reveal>
					<p>Manila, Philippines · GMT+8</p>
					<div>
						<a href="https://github.com/kxnn02" target="_blank" rel="me noopener">github.com/kxnn02</a>
						<a href="https://www.linkedin.com/in/kenneth-clein-fernandez-8a6b48258" target="_blank" rel="me noopener"
							>LinkedIn</a
						>
						{/* The PDF stays unpublished until the overclaims and phone number are removed. */}
						<a href={`mailto:${EMAIL}?subject=R%C3%A9sum%C3%A9%20request`}>Résumé on request</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="shell footer__in">
			<p>© 2026 Kenneth Clein T. Fernandez</p>
			<p>
				Built with Astro ·
				<a href="https://github.com/kxnn02/portfolio" target="_blank" rel="noopener">source</a>
			</p>
		</div>
	</footer>

	<script>
		// Reveal on scroll. If this file ever fails to load, the watchdog in the
		// document head drops the `js` class and everything shows up immediately.
		const targets = document.querySelectorAll('[data-reveal], [data-wipe]');

		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '0px 0px -10% 0px', threshold: 0.04 }
			);

			targets.forEach((target) => io.observe(target));
		} else {
			targets.forEach((target) => target.classList.add('is-in'));
		}

		(window as Window & { __revealReady?: boolean }).__revealReady = true;

		// Pointer parallax. The pointer's position in the viewport drives every
		// rigged element through the same field, so this never needs a
		// getBoundingClientRect per move. Fine pointers only, and never under
		// reduced motion — on a phone the whole block is skipped.
		const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
		const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (finePointer.matches && !stillMotion.matches) {
			type RigItem = {
				element: HTMLElement;
				travel: number;
				x: number;
				y: number;
				toX: number;
				toY: number;
			};

			const rig: RigItem[] = [];

			const rigElement = (element: HTMLElement | null, travel: number) => {
				if (element) rig.push({ element, travel, x: 0, y: 0, toX: 0, toY: 0 });
			};

			rigElement(document.querySelector<HTMLElement>('.hero__type'), 6);

			for (const row of document.querySelectorAll('.project')) {
				rigElement(
					row.querySelector<HTMLElement>('.shot-wrap') ?? row.querySelector<HTMLElement>('.panel'),
					12
				);
			}

			let frame = 0;

			const settle = () => {
				frame = 0;
				let moving = false;

				for (const item of rig) {
					item.x += (item.toX - item.x) * 0.08;
					item.y += (item.toY - item.y) * 0.08;

					if (Math.abs(item.toX - item.x) > 0.05 || Math.abs(item.toY - item.y) > 0.05) {
						moving = true;
					}

					item.element.style.transform = `translate3d(${item.x.toFixed(2)}px, ${item.y.toFixed(2)}px, 0)`;
				}

				if (moving) frame = requestAnimationFrame(settle);
			};

			window.addEventListener(
				'pointermove',
				(event) => {
					if (event.pointerType !== 'mouse') return;

					const nx = (event.clientX / window.innerWidth - 0.5) * 2;
					const ny = (event.clientY / window.innerHeight - 0.5) * 2;

					for (const item of rig) {
						item.toX = -nx * item.travel;
						item.toY = -ny * item.travel;
					}

					if (!frame) frame = requestAnimationFrame(settle);
				},
				{ passive: true }
			);
		}

		const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
		const status = document.querySelector('[data-copy-status]');
		const email = button?.dataset.email ?? '';

		button?.addEventListener('click', async () => {
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				button.textContent = 'Copied';
				button.setAttribute('aria-label', 'Email address copied');
				button.dataset.state = 'done';
				// The label change alone is not reliably announced, so the copy is
				// also pushed through a polite live region.
				if (status) status.textContent = 'Email address copied to clipboard';
				setTimeout(() => {
					button.textContent = 'Copy';
					button.setAttribute('aria-label', 'Copy email address to clipboard');
					delete button.dataset.state;
					if (status) status.textContent = '';
				}, 2000);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	</script>
</Base>
