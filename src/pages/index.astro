										d="M2.5 7h9M7.5 3l4 4-4 4"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</a>
							<a class="btn btn--ghost" href={`mailto:${EMAIL}`}>Email me</a>
						</div>
						<p class="hero__links">
							<a href="https://github.com/kxnn02" target="_blank" rel="me noopener">GitHub</a>
							<a href="https://www.linkedin.com/in/kenneth-clein-fernandez-8a6b48258" target="_blank" rel="me noopener"
								>LinkedIn</a
