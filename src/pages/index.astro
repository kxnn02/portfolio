---
import Base from '../layouts/Base.astro';

const title = 'Kenneth Clein T. Fernandez — Developer, Manila';
const description =
	'Third-year BSIT student in Manila. Shipped a campus alert app, a Telegram bot in production use by DEVCON Cohort 5, and the retrieval layer of a nonprofit operations platform. Open to internship hours.';
---

<Base {title} {description}>
	<div class="wrap">
		<header class="top">
			<span class="top__mark">KCF</span>
			<span class="top__meta">Manila, Philippines</span>
		</header>
	</div>

	<main>
		<div class="wrap">
			<section class="hero">
				<p class="eyebrow">Third-year BSIT · Full-stack internship candidate · Manila</p>
				<h1>Kenneth Clein T. Fernandez</h1>
				<p class="lede">
					I'm a third-year BSIT student at San Sebastian College – Recoletos Manila. I build software
					that ships: a campus alert app, a Telegram bot in production use by DEVCON's Cohort 5, and the
					retrieval layer of a nonprofit operations platform.
				</p>
				<p class="status">Available for OJT / internship hours</p>
				<div class="actions">
					<a class="btn" href="#contact">
						Get in touch
						<span class="btn__arrow" aria-hidden="true">↗</span>
					</a>
					<a class="link-mono" href="https://github.com/kxnn02">GitHub</a>
					<a class="link-mono" href="https://linkedin.com/in/kenneth-clein-fernandez">LinkedIn</a>
				</div>
			</section>

			<section class="section" id="work" aria-labelledby="work-title">
				<div class="section__head">
					<h2 id="work-title">Selected work</h2>
				</div>

				<ol class="work">
					<li class="work__item">
						<span class="work__idx" aria-hidden="true">01</span>
						<div class="work__body">
							<div class="work__title">
								<h3>CampusCurrents</h3>
								<span class="tag">Campus communication</span>
							</div>
							<p>
								Class suspension alerts, emergency notifications and school announcements in one app.
								I led five people as project manager and lead developer, shipped an Android beta, then
								a release that fixed the security and UX issues testers reported. The Supabase backend
								runs 50 migrations with row-level security and two-phase push delivery, with a receipt
								for every student.
							</p>
							<p class="work__meta">React Native (Expo) · Next.js · Supabase · PostgreSQL</p>
							<p class="work__links">
								<a href="https://github.com/kxnn02/campus-currents">Source code</a>
							</p>
						</div>
					</li>

					<li class="work__item">
						<span class="work__idx" aria-hidden="true">02</span>
						<div class="work__body">
							<div class="work__title">
								<h3>DEVCON Cohort 5 Task Bot</h3>
								<span class="tag">Telegram task manager</span>
							</div>
							<p>
								In production use by DEVCON Philippines' eight-person Cohort 5. A Telegram bot plus a
								Next.js dashboard with board, team and activity views; CI blocks any merge that fails
								typecheck, the full test suite or the migration check. 136 of 136 commits are mine,
								across 93 test files.
							</p>
							<p class="work__meta">Telegram Bot API · Next.js · PostgreSQL · CI</p>
							<p class="work__links">
								<a href="https://telegram-taskbot-ten.vercel.app">Live dashboard</a>
							</p>
						</div>
					</li>

					<li class="work__item">
						<span class="work__idx" aria-hidden="true">03</span>
						<div class="work__body">
							<div class="work__title">
								<h3>DEVCON Kids Hub</h3>
								<span class="tag">Nonprofit operations</span>
							</div>
							<p>
								Events, volunteer onboarding, chapters, inventory and post-event reporting for DEVCON
								Kids, built by five people. I owned the AI half: document ingestion and chunking,
								Mistral embeddings, pgvector search, the chat interface and an FAQ auto-builder. I also
								wrote the 39-case evaluation harness alone, covering grounding, citations, no-answer,
								injection and authorization.
							</p>
							<p class="work__meta">pgvector · Mistral · Next.js · Supabase</p>
							<p class="work__links">
								<a href="https://devcon-kids-hub-2-0.vercel.app">Live site</a>
							</p>
						</div>
					</li>

					<li class="work__item">
						<span class="work__idx" aria-hidden="true">04</span>
						<div class="work__body">
							<div class="work__title">
								<h3>DEVCON+</h3>
								<span class="tag">Internship</span>
							</div>
							<p>
								Volunteer internship in 2026 on DEVCON's membership platform. Fixed UI and data bugs in
								the admin dashboard — including duplicate chapter entries in chapter listings — and
								proposed a chapter leaderboard across 13 chapters.
							</p>
							<p class="work__meta">React · TypeScript · NestJS · Supabase · Firebase Auth</p>
							<p class="work__links">
								<a href="https://devcon.plus">Live site</a>
								<span class="tag">Private repo</span>
							</p>
						</div>
					</li>
				</ol>
			</section>

			<section class="contact" id="contact" aria-labelledby="contact-title">
				<h2 id="contact-title">Contact</h2>
				<p>Open to OJT and internship hours. Email is the fastest way to reach me — I'm in Manila (GMT+8).</p>
				<div class="email-row">
					<a class="email" href="mailto:fernandezk728@gmail.com">fernandezk728@gmail.com</a>
					<button
						class="copy"
						type="button"
						data-copy-email
						aria-label="Copy email address to clipboard"
					>Copy</button>
				</div>
				<div class="contact__links">
					<a href="https://github.com/kxnn02">github.com/kxnn02</a>
					<a href="https://linkedin.com/in/kenneth-clein-fernandez">LinkedIn</a>
				</div>
			</section>
		</div>
	</main>

	<footer class="footer">
		<div class="wrap">
			<p>Kenneth Clein T. Fernandez · Manila, Philippines</p>
			<p>Built with Astro. No client-side framework.</p>
		</div>
	</footer>

	<script>
		const button = document.querySelector('[data-copy-email]');
		const email = 'fernandezk728@gmail.com';

		button?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(email);
				button.textContent = 'Copied';
				button.dataset.state = 'done';
				setTimeout(() => {
					button.textContent = 'Copy';
					delete button.dataset.state;
				}, 2000);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	</script>
</Base>
