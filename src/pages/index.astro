---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ccShot from '../assets/shots/campuscurrents.png';
import taskbotShot from '../assets/shots/taskbot-help.png';
import kidshubShot from '../assets/shots/kidshub-login.png';
import devconShot from '../assets/shots/devconplus-home.png';
import portrait from '../assets/shots/portrait.jpg';

const title = 'Kenneth Clein T. Fernandez — I find the problem. I ship the fix';
const description =
	'Third-year BSIT student in Manila. I’ve shipped an Android campus-alert app, a Telegram bot in daily use, and a chatbot for a nonprofit. Open to OJT.';
const EMAIL = 'fernandezk728@gmail.com';

/* Each project carries its own visual. Two shapes, chosen by what the asset
   actually is: a wide screenshot fills the column, a portrait one is framed on
   a panel instead of being cropped into a shape it isn't. */
const work = [
	{
		idx: '01',
		kind: 'Android beta · 2026',
		name: 'CampusCurrents',
		href: 'https://campus-currents-website.vercel.app',
		role: 'Project manager & lead developer',
		problem:
			'Campus announcements were scattered across Facebook and other platforms, so suspension calls and emergency notices were easy to miss on the phones students already check.',
		body: 'We built one Android app for class suspensions, emergency notices and campus announcements, delivered straight to the student’s phone. The Supabase backend runs 50 migrations with row-level security, and push delivery reports a receipt for every student.',
		stack: 'React Native (Expo) · Next.js · Supabase · PostgreSQL',
		links: [
			{ label: 'Project site', href: 'https://campus-currents-website.vercel.app' },
			{ label: 'Download APK · 102 MB', href: 'https://github.com/kxnn02/campus-currents/releases/latest' },
			{ label: 'Source code', href: 'https://github.com/kxnn02/campus-currents' },
		],
		visual: {
			kind: 'shot',
			src: ccShot,
			alt: 'The CampusCurrents landing page: the headline “Stay Informed. Stay Safe.”, a red Try the Beta button, and a phone showing its Status screen reading CLASSES ARE ON.',
			caption: 'Landing page',
			note: 'campus-currents-website.vercel.app',
			noteHref: 'https://campus-currents-website.vercel.app',
		},
	},
	{
		idx: '02',
		kind: 'Telegram bot · 2026',
		name: 'DEVCON Cohort 5 Task Bot',
		href: 'https://telegram-taskbot-ten.vercel.app',
		role: 'Solo build',
		problem:
			'When a higher-up assigned a task, the cohort had no shared tracker — everyone made their own — and coordination lived in a Telegram group.',
		body: 'I built the bot inside Telegram, where the cohort already worked: a morning standup card grouped by person, overdue reminders and weekly digests, with board, team and activity views in a Next.js dashboard behind it.',
		stack: 'Telegram Bot API · Next.js · Supabase',
		links: [
			{ label: 'Dashboard — Telegram login', href: 'https://telegram-taskbot-ten.vercel.app' },
			{ label: 'Source code', href: 'https://github.com/kxnn02/telegram-taskbot' },
		],
		visual: {
			kind: 'card',
			src: taskbotShot,
			alt: 'A Telegram group with the bot\u2019s Available Commands card: /tasks, /deadlines and /standup to read work, /addtask to create it, and /done, /complete, /update and /due to change it.',
			caption: 'Command card, in Telegram',
			note: 'In the cohort’s Telegram group',
		},
	},
	{
		idx: '03',
		kind: 'Nonprofit platform · 2026',
		name: 'DEVCON Kids Hub',
		href: 'https://devcon-kids-hub-2-0.vercel.app',
		role: 'I built the AI chatbot',
		problem:
			'DEVCON Kids had no centralized platform. Borrowed materials had no shared record — some went missing and no one could say who had them — and onboarding a volunteer meant asking a higher-up and waiting for an answer.',
		body: 'The platform covers events, volunteer onboarding, chapters, inventory and reporting. The chatbot answers onboarding questions from DEVCON Kids’ documents.',
		stack: 'React · Vite · Supabase · pgvector · Mistral',
		links: [
			{ label: 'Live site', href: 'https://devcon-kids-hub-2-0.vercel.app' },
			{ label: 'Team repo', href: 'https://github.com/Debb1ie/DEVCON-Kids-Hub-2.0' },
		],
		visual: {
			kind: 'shot',
			src: kidshubShot,
			alt: 'The DEVCON Kids Hub sign-in page: a constellation graphic and the words “Learn. Build. Belong.” on the left, and a sign-in card on the right offering Continue with Google or email.',
			caption: 'Sign-in, role-based',
			note: 'The AI chat sits behind it',
		},
	},
	{
		idx: '04',
		kind: 'Internship · Aug–Sep 2026',
		name: 'DEVCON+',
		href: 'https://devcon.plus',
		role: 'Voluntary intern',
		problem:
			'Duplicate chapter entries were showing up in DEVCON’s admin dashboard, and chapter activity had no visible ranking.',
		body: 'During my internship on the membership platform — event registration, points and rewards, chapter operations across 13 chapters — I fixed the duplicate chapter entries and proposed the chapter leaderboard.',
		stack: 'React · TypeScript · NestJS · Supabase · Firebase Auth',
		links: [{ label: 'Public site', href: 'https://devcon.plus' }],
		visual: {
			kind: 'shot',
			src: devconShot,
			alt: 'The DEVCON+ member home screen: a greeting, 100 XP earned, quick actions for Find Jobs, Volunteer and Earn Points, and an Events Near You section.',
			caption: 'Member home',
			note: 'The admin dashboard is private',
		},
	},
];
---

<Base {title} {description}>
	<a class="skip" href="#work">Skip to work</a>

	<header class="site-head">
		<div class="shell site-head__in">
			<a class="brand" href="#top">
				<span class="sr-only">Kenneth Clein T. Fernandez, back to top</span>
				<span class="brand__name" aria-hidden="true">Kenneth Fernandez</span>
				<span class="brand__mark" aria-hidden="true">KCF</span>
			</a>
			<nav class="nav" aria-label="Sections">
				<a href="#work">Work</a>
				<a href="#about">About</a>
				<a class="nav__background" href="#background">Background</a>
				<a href="#contact">Contact</a>
			</nav>
		</div>
	</header>

	<main id="main">
		<section class="hero" id="top">
