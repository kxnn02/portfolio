	<script>
		// Reveal on scroll. If this file ever fails to load, the watchdog in the
		// document head drops the `js` class and everything shows up immediately.
		const targets = document.querySelectorAll('[data-reveal], [data-wipe]');

		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) reveal(entry.target);
					}
					// A target the observer skipped never reports as intersecting:
					// one already above the viewport at load, or one a jump passed in
					// a single frame. Sweep after every batch so nothing stays hidden.
					sweep();
				},
				{ rootMargin: '0px 0px -10% 0px', threshold: 0.04 }
			);

			function reveal(target: Element) {
				target.classList.add('is-in');
				io.unobserve(target);
			}

			// 0.9 matches the -10% bottom rootMargin, so both paths reveal on the
			// same line. Seventeen rect reads on a frame that follows a scroll or a
			// resize, and none at all once every target is in.
			let pending = 0;

			function sweep() {
				pending = 0;
				const limit = window.innerHeight * 0.9;

				for (const target of targets) {
					if (!target.classList.contains('is-in') && target.getBoundingClientRect().top < limit) {
						reveal(target);
					}
				}
			}

			function queueSweep() {
				if (!pending) pending = requestAnimationFrame(sweep);
			}

			targets.forEach((target) => io.observe(target));

			window.addEventListener('load', sweep);
			window.addEventListener('pageshow', sweep);
			window.addEventListener('resize', queueSweep);
			window.addEventListener('scroll', queueSweep, { passive: true });
		} else {
			targets.forEach((target) => target.classList.add('is-in'));
		}

		(window as Window & { __revealReady?: boolean }).__revealReady = true;

		// Manila time in the masthead. The markup ships "GMT+8" as the no-JS
		// fallback; this only replaces it once the page is running.
		const clock = document.querySelector<HTMLElement>('[data-clock]');

		if (clock) {
			const paintClock = () => {
				try {
					const time = new Intl.DateTimeFormat('en-GB', {
						timeZone: 'Asia/Manila',
						hour: '2-digit',
						minute: '2-digit',
						hourCycle: 'h23',
					}).format(new Date());
					clock.textContent = `${time} GMT+8`;
				} catch {
					// Keep the GMT+8 fallback.
				}
			};

			paintClock();
			window.setInterval(paintClock, 30_000);
		}

		// Pointer parallax. The pointer's position in the viewport drives every
		// rigged element through the same field, so this never needs a
		// getBoundingClientRect per move. Fine pointers only — on a phone the
		// whole block is skipped.
		const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

		if (finePointer.matches) {
			type RigItem = {
				element: HTMLElement;
				travel: number;
				x: number;
				y: number;
				toX: number;
				toY: number;
			};

			const rig: RigItem[] = [];

			const rigElement = (element: HTMLElement | null, travel: number) => {
				if (element) rig.push({ element, travel, x: 0, y: 0, toX: 0, toY: 0 });
			};

			rigElement(document.querySelector<HTMLElement>('.hero__type'), 6);

			for (const row of document.querySelectorAll('.project')) {
				rigElement(row.querySelector<HTMLElement>('.shot-wrap'), 12);
			}

			let frame = 0;

			// The halftone bloom. One accent layer follows the pointer across the
			// hero's existing dot field; only its transform changes.
			const hero = document.querySelector<HTMLElement>('.hero');
			const bloom = document.querySelector<HTMLElement>('[data-bloom]');
			let heroLeft = 0;
			let heroTop = 0;
			let heroWidth = 0;
			let heroHeight = 0;
			let bloomX = 0;
			let bloomY = 0;
			let bloomToX = 0;
			let bloomToY = 0;
			let bloomOn = false;

			const measureHero = () => {
				if (!hero) return;
				const rect = hero.getBoundingClientRect();
				heroLeft = rect.left + window.scrollX;
				heroTop = rect.top + window.scrollY;
				heroWidth = rect.width;
				heroHeight = rect.height;
			};

			if (hero && bloom) {
				measureHero();
				window.addEventListener('load', measureHero);
				window.addEventListener('pageshow', measureHero);
				window.addEventListener('resize', measureHero);

				hero.addEventListener('pointerenter', (event) => {
					if (event.pointerType !== 'mouse') return;
					const x = event.clientX + window.scrollX - heroLeft;
					const y = event.clientY + window.scrollY - heroTop;
					bloomX = bloomToX = x;
					bloomY = bloomToY = y;
					bloom.style.transform = `translate3d(${x}px, ${y}px, 0)`;
					bloomOn = true;
					bloom.classList.add('is-on');
				});

				hero.addEventListener('pointerleave', () => {
					bloomOn = false;
					bloom.classList.remove('is-on');
				});
			}

			const settle = () => {
				frame = 0;
				let moving = false;

				for (const item of rig) {
					item.x += (item.toX - item.x) * 0.08;
					item.y += (item.toY - item.y) * 0.08;

					if (Math.abs(item.toX - item.x) > 0.05 || Math.abs(item.toY - item.y) > 0.05) {
						moving = true;
					}

					item.element.style.transform = `translate3d(${item.x.toFixed(2)}px, ${item.y.toFixed(2)}px, 0)`;
				}

				if (hero && bloom && bloomOn) {
					bloomX += (bloomToX - bloomX) * 0.12;
					bloomY += (bloomToY - bloomY) * 0.12;

					if (Math.abs(bloomToX - bloomX) > 0.1 || Math.abs(bloomToY - bloomY) > 0.1) {
						moving = true;
					}

					bloom.style.transform = `translate3d(${bloomX.toFixed(1)}px, ${bloomY.toFixed(1)}px, 0)`;
				}

				if (moving) frame = requestAnimationFrame(settle);
			};

			window.addEventListener(
				'pointermove',
				(event) => {
					if (event.pointerType !== 'mouse') return;

					const nx = (event.clientX / window.innerWidth - 0.5) * 2;
					const ny = (event.clientY / window.innerHeight - 0.5) * 2;

					for (const item of rig) {
						item.toX = -nx * item.travel;
						item.toY = -ny * item.travel;
					}

					if (hero && bloom) {
						const x = event.clientX + window.scrollX - heroLeft;
						const y = event.clientY + window.scrollY - heroTop;
						const inside = x >= 0 && y >= 0 && x <= heroWidth && y <= heroHeight;

						if (inside) {
							if (!bloomOn) {
								bloomX = bloomToX = x;
								bloomY = bloomToY = y;
								bloom.style.transform = `translate3d(${x}px, ${y}px, 0)`;
								bloomOn = true;
								bloom.classList.add('is-on');
							} else {
								bloomToX = x;
								bloomToY = y;
							}
						} else if (bloomOn) {
							bloomOn = false;
							bloom.classList.remove('is-on');
						}
					}

					if (!frame) frame = requestAnimationFrame(settle);
				},
				{ passive: true }
			);

			// The loupe. The lens is a background-position crop of the same image,
			// so it adds no request and no library. Fine pointers only.
			for (const link of document.querySelectorAll<HTMLAnchorElement>('.shot-wrap a')) {
				const lens = link.querySelector<HTMLElement>('[data-loupe]');
				if (!lens) continue;

				let lensSize = 0;
				let backgroundSource = '';

				const placeLens = (event: PointerEvent) => {
					if (event.pointerType !== 'mouse') return;

					const rect = link.getBoundingClientRect();
					const x = event.clientX - rect.left;
					const y = event.clientY - rect.top;

					if (x < 0 || y < 0 || x > rect.width || y > rect.height) {
						lens.classList.remove('is-on');
						return;
					}

					const image = link.querySelector<HTMLImageElement>('img');
					if (!image) return;
					const source = image.currentSrc || image.src;

					if (!lensSize) lensSize = lens.offsetWidth;
					if (backgroundSource !== source) {
						backgroundSource = source;
						lens.style.backgroundImage = `url("${source}")`;
					}

					const scale = 2;
					lens.style.backgroundSize = `${rect.width * scale}px ${rect.height * scale}px`;
					lens.style.backgroundPosition = `${-(x * scale - lensSize / 2)}px ${-(y * scale - lensSize / 2)}px`;
					lens.style.transform = `translate3d(${x - lensSize / 2}px, ${y - lensSize / 2}px, 0)`;
					lens.classList.add('is-on');
				};

				link.addEventListener('pointerenter', placeLens);
				link.addEventListener('pointermove', placeLens);
				link.addEventListener('pointerleave', () => lens.classList.remove('is-on'));
			}
		}

		// The strip's pause control. The state lives on <html> so the inline head
		// script can restore it before the first frame; sessionStorage keeps it for
		// the visit, not forever. The loop still runs on first load by default.
		const stripToggle = document.querySelector<HTMLButtonElement>('[data-strip-toggle]');
		const stripLabel = stripToggle?.querySelector<HTMLElement>('[data-strip-label]');

		if (stripToggle) {
			let stripPaused = document.documentElement.classList.contains('strip-paused');

			const paintStrip = () => {
				document.documentElement.classList.toggle('strip-paused', stripPaused);
				if (stripLabel) stripLabel.textContent = stripPaused ? 'Play' : 'Pause';
			};

			paintStrip();

			stripToggle.addEventListener('click', () => {
				stripPaused = !stripPaused;
				paintStrip();
				try {
					sessionStorage.setItem('strip-paused', stripPaused ? '1' : '0');
				} catch {
					// Private mode or a blocked store: the control still works for this view.
				}
			});
		}

		// The strip is an index. Hovering, focusing or tapping a tool lights the
		// project rows whose stacks name it and writes the mapping into the
		// readout. The second set is the visual duplicate; it gets the same
		// active state but is not focusable.
		const strip = document.querySelector<HTMLElement>('[data-strip]');
		const stripReadout = document.querySelector<HTMLElement>('[data-strip-readout]');

		if (strip) {
			const stripIdle = stripReadout?.textContent ?? '';
			const toolNodes = [...strip.querySelectorAll<HTMLElement>('[data-tool]')];
			const projectRows = new Map<string, HTMLElement>();

			for (const row of document.querySelectorAll<HTMLElement>('.project[id]')) {
				projectRows.set(row.id, row);
			}

			let activeTool = '';

			const paintTool = (name: string) => {
				if (name === activeTool) return;
				activeTool = name;

				for (const node of toolNodes) {
					node.classList.toggle('is-active', node.dataset.tool === name);
				}

				for (const row of projectRows.values()) {
					row.classList.remove('is-indexed');
				}

				const node = toolNodes.find((item) => item.dataset.tool === name);
				const slugs = node?.dataset.projects?.split(' ') ?? [];

				for (const slug of slugs) {
					projectRows.get(slug)?.classList.add('is-indexed');
				}

				if (stripReadout) {
					stripReadout.textContent = name ? (node?.dataset.readout ?? '') : stripIdle;
				}
			};

			const toolFrom = (target: EventTarget | null) =>
				target instanceof Element ? target.closest<HTMLElement>('[data-tool]') : null;

			strip.addEventListener('pointerover', (event) => {
				const node = toolFrom(event.target);
				if (node) paintTool(node.dataset.tool ?? '');
			});

			strip.addEventListener('pointerleave', () => {
				if (!strip.contains(document.activeElement)) paintTool('');
			});

			strip.addEventListener('focusin', (event) => {
				const node = toolFrom(event.target);
				if (!node) return;

				strip.classList.add('is-focused');
				paintTool(node.dataset.tool ?? '');
			});

			strip.addEventListener('focusout', (event) => {
				if (event.relatedTarget instanceof Node && strip.contains(event.relatedTarget)) return;

				strip.classList.remove('is-focused');
				if (!strip.matches(':hover')) paintTool('');
			});

			strip.addEventListener('click', (event) => {
				const node = toolFrom(event.target);
				if (node) paintTool(node.dataset.tool ?? '');
			});
		}

		const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
		const status = document.querySelector('[data-copy-status]');
		const email = button?.dataset.email ?? '';

		button?.addEventListener('click', async () => {
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				button.textContent = 'Copied';
				button.setAttribute('aria-label', 'Email address copied');
				button.dataset.state = 'done';
				// The label change alone is not reliably announced, so the copy is
				// also pushed through a polite live region.
				if (status) status.textContent = 'Email address copied to clipboard';
				setTimeout(() => {
					button.textContent = 'Copy';
					button.setAttribute('aria-label', 'Copy email address to clipboard');
					delete button.dataset.state;
					if (status) status.textContent = '';
				}, 2000);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	</script>
</Base>
